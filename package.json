{
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "prebuild": "node scripts/generate-indexes.mjs",
    "build": "node scripts/generate-indexes.mjs && node scripts/vercel-dist.mjs && node scripts/copy-public-to-output.mjs",
    "verify:output": "node scripts/verify-output.mjs",
    "deploy:check": "npm run build && npm run verify:output",
    "buildCommand": "npm run deploy:check",
    "outputDirectory": ".vercel/output/static",
    "vercel:build": "vercel build",
    "vercel:deploy:preview": "vercel deploy --prebuilt"
  },
  "devDependencies": {
    "cheerio": "^1.1.2",
    "fast-glob": "^3.3.3",
    "globby": "^13.2.2",
    "gray-matter": "^4.0.3",
    "htmlparser2": "^10.0.0",
    "serve": "^14.2.5",
    "slugify": "^1.6.6",
    "vercel": "^50.4.8",
    "vite": "^7.2.7"
  }
}
