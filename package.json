{
  "engines": {
    "node": "20.x"
  },
  "type": "module",

  "scripts": {
    "prebuild": "node scripts/check-css.mjs && node scripts/check-canonical-grid.mjs && node scripts/generate-indexes.mjs",
    "build": "node scripts/generate-indexes.mjs && node scripts/vercel-dist.mjs",
    "verify:output": "node scripts/verify-output.mjs",
    "deploy:check": "npm run build && npm run verify:output",

    "partials:inject": "node scripts/inject-partials.mjs",
    "partials:check": "node scripts/check-partials.mjs",

    "validate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate.ps1",
    "validate:html-contracts": "node scripts/validate-head-body.js"
  },

  "devDependencies": {
    "cheerio": "^1.1.2",
    "fast-glob": "^3.3.3",
    "globby": "^13.2.2",
    "gray-matter": "^4.0.3",
    "htmlparser2": "^10.0.0",
    "serve": "^14.2.5",
    "slugify": "^1.6.6",
    "vite": "^7.2.7"
  }
}
